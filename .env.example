# Copy this file to .env and fill in your key. .env is git-ignored: never commit it.
ANTHROPIC_API_KEY=

# Optional: official voice-over with Azure AI Speech (free tier F0). See README → Giọng đọc.
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=southeastasia
# auto (default): Azure when configured, Edge if Azure fails · azure: Azure only · edge: Edge only
# CODELENS_TTS_PROVIDER=auto

# Optional: post clips straight to a Facebook Page (not a personal profile).
# FB_PAGE_TOKEN is a Page access token with the pages_manage_posts permission. Keep it secret.
# FB_PAGE_ID=
# FB_PAGE_TOKEN=
# FB_PAGE_NAME=CodeLens

# Optional
# CODELENS_MODEL=claude-opus-5-5
# PORT=5173
# HOST=127.0.0.1
# CODELENS_DATA_DIR=data
